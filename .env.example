# Copy to .env.local and fill in. Bank sync is optional — the app works fully manual.
#
# Get free sandbox keys from https://dashboard.plaid.com/ (Sign up -> Sandbox).
# PLAID_ENV=sandbox is safe for testing; use `development` for real (non-US?) banks
# or link with test credentials. Never commit real secrets.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
